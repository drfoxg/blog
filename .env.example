APP_NAME=Laravel
#APP_ENV=production
APP_ENV=local
APP_KEY=
#APP_DEBUG=false
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
#CACHE_DRIVER устарело в Laravel 11
#CACHE_DRIVER=file
#CACHE_DRIVER=redis
CACHE_STORE=redis
CACHE_PREFIX=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Отдельная БД для сессий, соединиение default
REDIS_DB=0
# Отдельная БД для кеша (опционально)
REDIS_CACHE_DB=1
# Отдельная БД для очереди (опционально)
REDIS_QUEUE_DB=2

# queue - название соединения из config/database.php
# подставляется в config/queue.php, чтобы дальше использвать для QUEUE_CONNECTION
REDIS_QUEUE_CONNECTION=queue

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

DB_ROOT_PASSWORD=XXXXXX

TRUSTED_PROXIES=192.168.48.0/20,172.21.0.0/16

FRONTEND_URL=https://fiontech.ru

# ============================================================
# Telegram Bot API
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Адрес локального прокси внутри Docker-сети
TELEGRAM_PROXY_URL=http://tgwsapiproxy:8080

TELEGRAM_API_VERSION=
DEPRECATION_DATE=

ADMIN_NAME=XXXXX
ADMIN_EMAIL=XXXXXX@XXXXXX.XXX
ADMIN_PASSWORD=XXXXXX

# ============================================================
# Docker Compose (Laravel не читает)
# ============================================================
